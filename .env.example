# Variáveis públicas embarcadas no frontend durante o build
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Variáveis exclusivas do servidor, configuradas no runtime do container
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Obrigatória para Auth Admin e demais operações privilegiadas.
# Nunca use prefixo VITE_, nunca passe como build arg e nunca grave o valor no Git.
SUPABASE_SERVICE_ROLE_KEY=configure-securely-in-runtime

# Token da Management API do Supabase — usado só pela tela /admin/migrations
# para aplicar SQL de supabase/pending-migrations/ direto em produção.
SB_MANAGEMENT_ACCESS_TOKEN=configure-securely-in-runtime

# E-mail transacional (Resend). Sem isso, e-mails automáticos ficam registrados
# como falha e nada é enviado de verdade.
RESEND_API_KEY=

# IA — pelo menos um dos dois habilita resumos/traduções automáticas.
GEMINI_API_KEY=
GROQ_API_KEY=

# Google Drive — conta de serviço direta (caminho único hoje; sem isso os
# documentos gerados não são arquivados automaticamente no Drive).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
