# Variáveis públicas embarcadas no frontend durante o build
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Variáveis exclusivas do servidor, configuradas no runtime do container
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Obrigatória para Auth Admin e demais operações privilegiadas.
# Nunca use prefixo VITE_, nunca passe como build arg e nunca grave o valor no Git.
SUPABASE_SERVICE_ROLE_KEY=configure-securely-in-runtime
